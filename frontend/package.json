{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "codegen": "node scripts/sync-deployment-config.mjs && node scripts/generate-brand-logo.mjs && node scripts/generate-llms-txt.mjs",
    "predev": "npm run codegen",
    "prebuild": "npm run codegen",
    "pretypecheck": "npm run codegen",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --old-asset-ttl 86400",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging --old-asset-ttl 86400",
    "dev:against-prod": "node scripts/dev-against-prod.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.9",
    "@openpanel/nextjs": "^1.5.1",
    "@tanstack/react-query": "^5.101.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "next": "^16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "24.13.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sharp": "^0.34.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
