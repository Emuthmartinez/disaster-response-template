# Caddy para PRODUCCIÓN en un único VPS.
#
# Este archivo usa placeholders {$VAR} que Caddy sustituye desde el entorno
# del proceso al cargar el Caddyfile — docker-compose.prod.yml pasa
# `env_file: .prod.env` al servicio `caddy`, así que basta con definir
# WEB_DOMAIN / API_DOMAIN / ADMIN_DOMAIN / ACME_EMAIL en tu `.prod.env` (ver
# `.env.example`). No hace falta editar este archivo por deploy.
#
# TLS: por defecto Caddy pide certificados automáticos vía Let's Encrypt
# (HTTP-01/ALPN), lo que requiere que el VPS reciba tráfico :80/:443 en los
# dominios configurados. Si prefieres certificados propios (p.ej. Origin CA de
# un proxy delante), reemplaza el bloque `tls` de cada sitio por
# `tls /etc/caddy/certs/<dominio>.crt /etc/caddy/certs/<dominio>.key`.
#
# Todos los sitios anteponen cabeceras de seguridad (defensa en profundidad
# junto a helmet en backend y Next headers en frontend). CSP la sirve Next.js.

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), interest-cohort=(), geolocation=(self)"
		-Server
	}
}

# Sitio público (frontend). Sirve /_next/static con cache larga (assets
# versionados por build id) y sin cache el resto (HTML/SSR).
{$WEB_DOMAIN}, www.{$WEB_DOMAIN} {
	encode zstd gzip
	import security_headers

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	@notStatic not path /_next/static/*
	header @notStatic Cache-Control "no-cache, must-revalidate"

	reverse_proxy frontend:3000
}

# API (backend). Reenvía la IP real del cliente para rate-limit/hashing por IP.
{$API_DOMAIN} {
	encode zstd gzip
	import security_headers

	reverse_proxy backend:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}
}

# Panel de administración (BFF Next.js standalone).
{$ADMIN_DOMAIN} {
	encode zstd gzip
	import security_headers

	reverse_proxy admin:3000
}
