# ============================================================================
# .env.example — contrato de variables de entorno del monorepo (frontend +
# backend + worker + admin + infra). Copia a `.env` y rellena. `.env` está
# gitignored: NUNCA commitees secretos reales.
#
# Marcas:
#   [REQ]  necesario para un despliegue de producción funcional y seguro (el
#          server falla al arrancar, o el sistema queda inseguro/incompleto
#          sin esto).
#   [OPT]  opcional: tiene un default sano en código, o activa/afina una
#          integración de terceros que puedes dejar apagada.
#
# Para LEVANTAR LOCAL solo necesitas `docker compose up --build -d`: el compose
# ya trae valores de desarrollo embebidos (DB, JWT dev, seed admin). Este
# archivo documenta el contrato completo para producción y para correr piezas
# sueltas a mano.
#
# TODOS los valores de este archivo son placeholders obviamente falsos. Antes
# de desplegar, genera tus propios secretos (ver los comandos `openssl rand`
# junto a cada uno) y usa tus propios dominios.
# ============================================================================


# ─────────────────────────────── BACKEND (API) ─────────────────────────────

# [REQ] Postgres del backend (TCP). LOCAL: el compose usa db:5432.
#       PROD: apunta al Postgres del mismo VPS (servicio `db` de
#       docker-compose.prod.yml) o a uno externo.
DATABASE_URL=postgres://app_user:CHANGE_ME_DB_PASSWORD@localhost:5432/app

# [OPT] Valkey/Redis para rate-limit compartido. Sin esto, cae a memoria
#       (degradado: rate-limit por proceso, no compartido entre réplicas).
VALKEY_URL=redis://localhost:6379

# [OPT] Entorno. development | production | test. La imagen fija production.
NODE_ENV=development
# [OPT] Puerto del backend.
PORT=8080

# --- Auth: superficie /admin (legado, contraseña compartida) ---
# [OPT] Contraseña del panel /admin legado (header x-admin-token). Comparación
#       constante. Recomendado en prod aunque no bloquea el arranque.
#       Genera con: openssl rand -base64 12
ADMIN_PASSWORD=CHANGE_ME_32_CHARS_RANDOM_SECRET

# --- Auth: motor RBAC api/public/* (JWT + roles + capacidades) ---
# [REQ] Secreto de firma HS256 del JWT. >=32 chars o el server NO arranca en
#       producción. Genera con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_CHARS_RANDOM_JWT_SECRET
# [OPT] Vida del access token (segundos). Default 12h.
JWT_TTL_SECONDS=43200
# [OPT] Nombre de la cookie httpOnly de sesión.
AUTH_COOKIE_NAME=mapa_session
# [REQ] Cookie Secure (HTTPS). En prod DEBE ser true o el server no arranca.
#       LOCAL http: false.
COOKIE_SECURE=false
# [REQ] Base para los links de invitación/reset que arma el BACKEND. Debe ser
#       el PANEL ADMIN (ahí aterriza quien acepta: /invite/<token>), NO el
#       sitio público. Prod: https://admin.example.org
APP_BASE_URL=http://localhost:3001
# [OPT] Caducidad de una invitación (horas).
INVITE_TTL_HOURS=72

# --- Superadmin semilla (lo crea el seed del job de migración, idempotente) ---
# [REQ] Email + contraseña del primer superadmin del motor RBAC.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=CHANGE_ME_32_CHARS_ADMIN_PASSWORD

# --- SMTP (emails de invitación + reset de contraseña por OTP) ---
# [OPT] Sin SMTP_HOST, el invite devuelve el link en la respuesta y el OTP se
#       loguea (modo dev). En prod configúralo con tu proveedor real.
SMTP_HOST=smtp.example.org
# [OPT] Puerto SMTP.
SMTP_PORT=587
# [OPT] Usuario SMTP.
SMTP_USERNAME=noreply@example.org
# [OPT] Password SMTP.
SMTP_PASSWORD=CHANGE_ME_32_CHARS_SMTP_PASSWORD
# [OPT] Remitente de los emails transaccionales.
SMTP_FROM=Mapa de Emergencia <noreply@example.org>

# --- Docs de API, métricas ---
# [OPT] Habilita Swagger UI + /api/openapi.json en producción (default
#       cerrado: expone todo el mapa de endpoints, evita regalarlo a un
#       atacante).
ENABLE_API_DOCS=false
# [OPT] Bearer token que protege GET /metrics (Prometheus). Sin él el
#       endpoint queda abierto; la defensa primaria es que /metrics vive en
#       METRICS_PORT, que el borde público no enruta.
METRICS_TOKEN=
# [OPT] Puerto del servidor de métricas separado (aislado del borde
#       público).
METRICS_PORT=9090

# --- Anti-bot, CORS, privacidad ---
# [REQ EN PRODUCCIÓN] Cloudflare Turnstile (prueba de humanidad en writes
#       públicos: reportes, desaparecidos, contacto, donaciones, chat,
#       hospitales, importación de pacientes). Sin la secret key,
#       requireHuman se desactiva SILENCIOSAMENTE (fail-open) — no hay
#       ningún aviso en el arranque. Cuenta gratis en
#       https://dash.cloudflare.com/?to=/:account/turnstile (unos minutos).
#       En DEV puedes dejarla vacía. Si vas a producción sin ella, es una
#       decisión consciente tuya de correr sin anti-bot en escritura
#       pública — no un default seguro.
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY
# [REQ] Orígenes del frontend permitidos por CORS (coma-separados). NO uses
#       "*". Prod: https://example.org
CORS_ORIGINS=http://localhost:3000
# [REQ] Sal para hashear IPs antes de persistir (privacidad). >=32 chars o el
#       server no arranca en producción (sin sal, el hash de IP es reversible
#       por fuerza bruta del espacio IPv4). Genera con: openssl rand -hex 16
IP_SALT=CHANGE_ME_32_CHARS_IP_SALT_VALUE
# [REQ] Secreto HMAC para deduplicar documentos de pacientes importados sin
#       guardar cédulas/documentos crudos fuera de staging. >=32 chars o el
#       server NO arranca en producción. Genera con: openssl rand -hex 32
PATIENT_DOCUMENT_HASH_SECRET=CHANGE_ME_32_CHARS_PATIENT_HASH_SECRET
# [OPT] Cabecera de IP de confianza. Default VACÍO: el deploy por defecto de
#       este template (docker-compose.prod.yml) es Caddy directo en un único
#       VPS, SIN proxy/CDN delante, así que ninguna cabecera es de confianza
#       (clientIp() cae a la IP del socket, req.ip). Ponla en
#       `cf-connecting-ip` ÚNICAMENTE si de verdad desplegaste Cloudflare (u
#       otro proxy que reescriba la cabecera en cada hop, de forma que el
#       cliente no pueda falsificarla) delante del VPS — configurarla sin
#       ese proxy real deja que cualquier cliente falsifique su IP y evada
#       el rate-limit / el dedup por IP.
TRUSTED_IP_HEADER=

# --- Cron / colas / analítica — [OPT] ---
# Secreto para los endpoints de cron (Authorization: Bearer).
CRON_SECRET=CHANGE_ME_CRON_SECRET
# Prefijo y retención de colas BullMQ.
QUEUE_PREFIX=mapa
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000
# Proxy de analítica OpenPanel (server-side).
OPENPANEL_API_URL=https://api.openpanel.dev
OPENPANEL_CLIENT_SECRET=CHANGE_ME_OPENPANEL_CLIENT_SECRET

# [OPT, SOLO TESTS] Desactiva rate-limit en la suite de tests. NUNCA en prod.
# RATE_LIMIT_DISABLED=1


# ───────────────────────── FEATURE FLAGS (integraciones) ────────────────────
# Cada integración externa se puede apagar por completo con su flag. Todas
# empiezan en `false`: el template funciona sin ninguna de ellas configurada.

# [OPT] Directorio de centros de acopio vía ResponseGrid (proxeado por el
#       backend en /api/acopio + /api/needs). Actívalo solo si vas a usar esa
#       API externa.
ENABLE_RESPONSEGRID=false
# [OPT] Federación/sincronización con otras instancias del hub (réplica SQL
#       pública + sync de reportes entre despliegues hermanos).
ENABLE_HUB_FEDERATION=false
# [OPT] OCR/ICR de importación de pacientes vía un proveedor de visión (VL).
ENABLE_PATIENT_OCR=false
# [OPT] Fuente de sincronización externa de ejemplo (worker `sync`). Actívala
#       solo tras adaptar el adaptador a tu propia fuente de datos.
ENABLE_EXAMPLE_SOURCE=false

# --- ResponseGrid (solo si ENABLE_RESPONSEGRID=true) ---
# [OPT] URL base de la API pública de ResponseGrid.
RESPONSEGRID_API_URL=https://api.responsegrid.app
# [OPT] Slug de la emergencia/instancia en ResponseGrid. Placeholder:
#       reemplaza por el identificador real de tu emergencia.
RESPONSEGRID_EMERGENCY_SLUG=your-emergency-slug
# [OPT] api-key de service account de ResponseGrid para PUBLICAR necesidades
#       (/api/needs). Se envía como cabecera x-api-key junto al campo
#       `author`. Sin esto, publicar queda deshabilitado (el endpoint
#       responde 503).
RESPONSEGRID_API_KEY=

# --- OCR/ICR de pacientes (solo si ENABLE_PATIENT_OCR=true) ---
# [OPT] Sin API key, la entrada image/* y PDF sigue rechazada con 501. No
#       hardcodear tokens.
MINIMAX_API_KEY=
# [OPT] Endpoint del proveedor OCR/ICR (compatible OpenAI).
MINIMAX_OCR_BASE_URL=https://api.minimax.io/v1
# [OPT] Modelo de visión (VL) a usar.
MINIMAX_OCR_MODEL=MiniMax-M3
MINIMAX_OCR_MAX_TOKENS=2048
MINIMAX_OCR_TIMEOUT_MS=30000
MINIMAX_OCR_PROMPT=


# ─────────────────── WORKER (sync / geocode / hub / backfill) ───────────────
# Casi todo tiene defaults sanos en código. Lo relevante para PROD:

# [OPT] Scheduler de sync de fuentes externas (gateado también por
#       ENABLE_EXAMPLE_SOURCE). 0 = apagado.
SYNC_SCHEDULERS=0
# [OPT] Csv de ids de fuente para acotar cuáles corren (ver
#       worker/sync/sources/index.ts). Vacío = todas las fuentes registradas.
SYNC_SOURCES=
# [OPT] Scheduler de federación del hub (gateado también por
#       ENABLE_HUB_FEDERATION). 0 = apagado.
HUB_SCHEDULERS=0

# [OPT] Sismos (worker earthquakes.queue.ts): el scheduler SIEMPRE corre (no
# va bajo SYNC_SCHEDULERS): dato público y barato. Cadencia del sync
# incremental del feed realtime (default 60s). Backfill de arranque (días) si
# la tabla está vacía → siembra sola en el primer deploy. El bounding box es
# global por defecto; recórtalo a tu región operativa.
EARTHQUAKES_EVERY_MS=60000
EARTHQUAKES_BACKFILL_DAYS=30
# EARTHQUAKES_FEED_PATH=/earthquakes/feed/v1.0/summary/2.5_week.geojson
# Ejemplo: recorta el feed global a tu región operativa (bounding box en
# grados decimales, WGS84). Los valores de ejemplo son un rectángulo
# arbitrario — reemplázalos por el de tu zona de operación.
# EARTHQUAKES_MIN_LAT=-10
# EARTHQUAKES_MAX_LAT=10
# EARTHQUAKES_MIN_LNG=-80
# EARTHQUAKES_MAX_LNG=-60

# [OPT] Carpeta de migraciones (el job de migración la apunta un nivel arriba
#       si corre con otro cwd).
MIGRATIONS_DIR=infra/db/migrations


# ─────────────────────── FRONTEND (Next.js, NEXT_PUBLIC_*) ──────────────────
# Se INLINEAN en build (build-args del Dockerfile). Los cambios de estas
# variables requieren rebuild + redeploy del frontend.

# [REQ] URL ABSOLUTA del backend para el BROWSER. Prod: https://api.example.org
NEXT_PUBLIC_API_URL=http://localhost:8080
# [REQ] URL del backend para SSR/Server Components DENTRO de Docker (red
#       interna). Sin esto, el fetch SSR cae a localhost dentro del
#       contenedor frontend y falla.
INTERNAL_API_URL=http://backend:8080
# [OPT] Base pública del CDN de fotos (no sensible). Vacío = las fotos se
#       sirven desde el propio backend.
NEXT_PUBLIC_R2_PUBLIC_BASE=
# [REQ EN PRODUCCIÓN] Site key pública de Turnstile (el widget). Pareja de
#       TURNSTILE_SECRET_KEY — sin ambas, el widget no aparece y/o el backend
#       no verifica nada. Misma cuenta gratis de Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY
# [REQ EN PRODUCCIÓN] Mismo valor que arriba pero con el nombre que usa el
#       build-arg del Dockerfile del frontend.
TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY
# [OPT] Prefijo CDN para /_next/static (R2 u otro object storage). Sin setear
#       → assets servidos por la app.
NEXT_PUBLIC_ASSET_PREFIX=
# [OPT] País por defecto del directorio de acopio.
NEXT_PUBLIC_ACOPIO_DEFAULT_COUNTRY=Example Country
# [OPT] OpenPanel (analítica) — cliente público.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_PRODUCTION_HOST=
NEXT_PUBLIC_OPENPANEL_DASHBOARD_URL=
# [OPT] Google Analytics 4 measurement id (formato G-XXXXXXXXXX). Vacío =
#       GA deshabilitado.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# [OPT] URLs de donación de TU organización (Stripe Payment Link / PayPal).
#       Vacías = la UI de donaciones queda oculta. Nunca uses enlaces que no
#       controle tu organización.
NEXT_PUBLIC_STRIPE_DONATION_URL=
NEXT_PUBLIC_PAYPAL_DONATION_URL=
# [OPT] Variante server-side (misma URL que arriba) que el backend devuelve
#       en el body de POST /api/donations (campo `paypalUrl`). Vacío = ese
#       campo sale `null` en la respuesta (no hay un endpoint /config
#       separado).
PAYPAL_DONATION_URL=
# [OPT] Enlace de WhatsApp para coordinar donaciones en especie. Vacío = oculto.
NEXT_PUBLIC_RESPONSEGRID_WHATSAPP_URL=
# [OPT] URL de transparencia de gastos operativos de la plataforma (link del
#       botón/sección de gastos). Vacío = cae a "/contacto".
NEXT_PUBLIC_EXPENSES_URL=
# [OPT] Variante de copy/experimento para analítica de la home (A/B). Vacío =
#       cae a "base".
NEXT_PUBLIC_PROPOSAL_VARIANT=
# [OPT] Slug de tu emergencia en ResponseGrid (Global Emergency), usado por
#       el CLIENTE para armar los links públicos /e/<slug> (login, feed).
#       Vacío = esos links quedan ocultos. Distinto de
#       RESPONSEGRID_EMERGENCY_SLUG (server-side, sección FEATURE FLAGS).
NEXT_PUBLIC_RESPONSEGRID_SLUG=
# [OPT] Dominio apex del sitio (sin protocolo, p.ej. example.org). Si lo
#       configuras, se añade `https://*.<dominio>` a connect-src/img-src de
#       la CSP para cubrir subdominios propios que no pasan por
#       NEXT_PUBLIC_API_URL. Vacío = no se añade nada extra.
NEXT_PUBLIC_SITE_APEX_DOMAIN=


# ───────────────────────── HUB FEDERATION (opcional) ────────────────────────
# Réplica pública de solo lectura hacia otro despliegue hermano del mismo
# template (solo si ENABLE_HUB_FEDERATION=true). Si faltan estas variables,
# el endpoint de credenciales del hub responde 503 y el resto del backend
# sigue intacto.

# [OPT] Conexión privada del rol CREATEROLE del backend al hub.
HUB_ADMIN_DATABASE_URL=
# [OPT] Host PÚBLICO del hub que se entrega al consumidor (vía DNS).
HUB_PUBLIC_HOST=
# [OPT] Nombre de la base de datos publicable en el hub.
HUB_DB_NAME=public_db
# [OPT] Token de API de Hetzner Cloud con permiso de escribir firewalls
#       (idealmente scoped a un solo proyecto/recurso). Junto con
#       HUB_FIREWALL_ID, gestiona la regla de firewall que abre/cierra la IP
#       de cada consumidor del hub. Sin esto, ese endpoint de gestión de
#       firewall responde 503 (el resto del backend sigue intacto).
HCLOUD_TOKEN=
# [OPT] id numérico del firewall de Hetzner Cloud del hub a editar (output
#       del firewall al crearlo en HCloud).
HUB_FIREWALL_ID=


# ─────────────────── R2 / OBJECT STORAGE (opcional) ─────────────────────────
# Compatible con S3 (Cloudflare R2 u otro proveedor) para fotos rehosteadas +
# /_next/static. Todas [OPT]: sin configurar, las fotos se sirven desde el
# backend y los estáticos desde la propia app.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STATIC_BUCKET=
R2_PUBLIC_BASE=
# [OPT] Prefijo de namespace para las keys de foto. Vacío en prod (keys
#       `images/...`). En un entorno de pruebas usa un prefijo (p.ej.
#       "staging") para AISLAR fotos en el mismo bucket sin pisar prod.
R2_KEY_PREFIX=


# ───────────────────────── PANEL ADMIN (admin/, 3er tier) ───────────────────
# Microservicio Next standalone. El navegador habla SOLO con su BFF
# same-origin; el BFF llama al backend server-side. NO usa DB/Valkey/
# Turnstile (no hereda el entorno del backend).

# [REQ] URL del backend para el BFF del admin (server-to-server). En un
#       clúster/compose usa la red INTERNA (no el dominio público). Local
#       (compose): http://backend:8080
EMERGENCY_API_URL=http://backend:8080
# [REQ] Cookie de sesión del panel Secure (HTTPS). Local http: false.
COOKIE_SECURE=false
# [OPT] Vida de la cookie de sesión del panel (segundos). Default 12h.
#       Espeja JWT_TTL_SECONDS del backend.
SESSION_MAX_AGE_SECONDS=43200
# [OPT] API de insumos (aún no usada por ninguna ruta).
SUPPLIES_API_URL=
# [OPT] Prefijo CDN de los estáticos del panel. Útil solo para forzar un
#       prefijo distinto al correr el build a mano.
NEXT_PUBLIC_ADMIN_ASSET_PREFIX=
# [REQ] Base pública del panel para que el BACKEND arme los links de
#       invitación. En compose ya se inyecta como APP_BASE_URL del backend.
#       Prod: https://admin.example.org
ADMIN_BASE_URL=https://admin.example.org


# ─────────────────────── CADDY / DOMINIOS (solo prod) ───────────────────────
# Usados por Caddyfile.example vía placeholders {$VAR}. Sin estos, Caddy no
# levanta en producción (docker-compose.prod.yml).

# [REQ] Dominio del sitio público (frontend).
WEB_DOMAIN=example.org
# [REQ] Dominio de la API (backend).
API_DOMAIN=api.example.org
# [REQ] Dominio del panel admin.
ADMIN_DOMAIN=admin.example.org
# [REQ] Email de contacto para el registro ACME (Let's Encrypt) del
#       certificado TLS.
ACME_EMAIL=admin@example.org


# ───────────────────── POSTGRES / VALKEY (docker-compose.prod.yml) ─────────
# Credenciales del Postgres y Valkey co-ubicados en el mismo VPS (perfil
# "un solo box"). Úsalas para construir tu propio DATABASE_URL/VALKEY_URL.

# [REQ] Credenciales del Postgres de producción.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_32_CHARS_POSTGRES_PASSWORD
POSTGRES_DB=app
# [REQ] Password del Valkey de producción (--requirepass).
VALKEY_PASSWORD=CHANGE_ME_32_CHARS_VALKEY_PASSWORD


# ───────────────────────── DESARROLLO LOCAL (docker-compose.yml) ────────────
# Solo relevantes para `docker compose up` local; no aplican a producción.

# [OPT] Objetivo de conexión del backend a la base: `db:5432` (default) o
#       `pgbouncer:6432` si levantas el profile `pgbouncer`.
DB_TARGET=db:5432
# [OPT] `1` para saltar el seed de datos demo del servicio migrate-seed.
SKIP_SEED=0
